{
  "name": "session",
  "description": "Manage dedicated game-server sessions",
  "type": 1,
  "options": [
    {
      "type": 1,
      "name": "create",
      "description": "Create a draft game-server session",
      "options": [
        {
          "type": 3,
          "name": "slug",
          "description": "Lowercase identifier, for example saturday-arma",
          "required": true,
          "min_length": 1,
          "max_length": 64
        },
        {
          "type": 3,
          "name": "name",
          "description": "Human-readable session name",
          "required": true,
          "min_length": 1,
          "max_length": 100
        },
        {
          "type": 3,
          "name": "game",
          "description": "Dedicated-server game",
          "required": false,
          "choices": [
            {
              "name": "Arma 3",
              "value": "arma3"
            }
          ]
        }
      ]
    },
    {
      "type": 1,
      "name": "list",
      "description": "List your game-server sessions"
    },
    {
      "type": 1,
      "name": "status",
      "description": "Show metadata and lifecycle status for a session",
      "options": [
        {
          "type": 3,
          "name": "session-id",
          "description": "Platform session identifier",
          "required": true,
          "min_length": 1,
          "max_length": 64
        }
      ]
    }
  ]
}
