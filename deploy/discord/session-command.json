{
  "name": "session",
  "description": "Manage dedicated game-server sessions",
  "type": 1,
  "options": [
    {
      "type": 1,
      "name": "create",
      "description": "Create a draft game-server session",
      "options": [
        {
          "type": 3,
          "name": "slug",
          "description": "Lowercase identifier, for example saturday-arma",
          "required": true,
          "min_length": 1,
          "max_length": 64
        },
        {
          "type": 3,
          "name": "name",
          "description": "Human-readable session name",
          "required": true,
          "min_length": 1,
          "max_length": 100
        },
        {
          "type": 3,
          "name": "game",
          "description": "Dedicated-server game",
          "required": false,
          "choices": [
            {
              "name": "Arma 3",
              "value": "arma3"
            }
          ]
        }
      ]
    },
    {
      "type": 1,
      "name": "list",
      "description": "List your game-server sessions"
    },
    {
      "type": 1,
      "name": "status",
      "description": "Show metadata and lifecycle status for a session",
      "options": [
        {
          "type": 3,
          "name": "session-id",
          "description": "Platform session identifier",
          "required": true,
          "min_length": 1,
          "max_length": 64
        }
      ]
    },
    {
      "type": 1,
      "name": "configure",
      "description": "Configure a draft session",
      "options": [
        {
          "type": 3,
          "name": "session-id",
          "description": "Platform session identifier",
          "required": true,
          "min_length": 1,
          "max_length": 64
        },
        {
          "type": 3,
          "name": "profile",
          "description": "Game-server profile",
          "required": false,
          "choices": [
            { "name": "Arma 3 default", "value": "arma3-default" }
          ]
        },
        {
          "type": 4,
          "name": "sleep-minutes",
          "description": "Minutes empty before sleeping",
          "required": false,
          "min_value": 10,
          "max_value": 1440
        },
        {
          "type": 4,
          "name": "archive-days",
          "description": "Days sleeping before archival",
          "required": false,
          "min_value": 1,
          "max_value": 90
        },
        {
          "type": 5,
          "name": "teamspeak",
          "description": "Enable TeamSpeak for this session",
          "required": false
        },
        {
          "type": 5,
          "name": "vanilla",
          "description": "Use anonymous SteamCMD without a mod preset",
          "required": false
        }
      ]
    },
    {
      "type": 1,
      "name": "upload-mission",
      "description": "Submit an Arma mission for validation",
      "options": [
        {
          "type": 3,
          "name": "session-id",
          "description": "Platform session identifier",
          "required": true
        },
        {
          "type": 11,
          "name": "file",
          "description": "Mission .pbo file (maximum 100 MiB)",
          "required": true
        }
      ]
    },
    {
      "type": 1,
      "name": "upload-preset",
      "description": "Submit an Arma launcher preset for validation",
      "options": [
        {
          "type": 3,
          "name": "session-id",
          "description": "Platform session identifier",
          "required": true
        },
        {
          "type": 11,
          "name": "file",
          "description": "Launcher preset .html file (maximum 10 MiB)",
          "required": true
        }
      ]
    },
    {
      "type": 1,
      "name": "start",
      "description": "Provision infrastructure for a configured session",
      "options": [
        {
          "type": 3,
          "name": "session-id",
          "description": "Platform session identifier",
          "required": true,
          "min_length": 1,
          "max_length": 64
        }
      ]
    },
    {
      "type": 1,
      "name": "sleep",
      "description": "Stop a running server while retaining its EBS volumes",
      "options": [{"type": 3, "name": "session-id", "description": "Session identifier", "required": true}]
    },
    {
      "type": 1,
      "name": "wake",
      "description": "Start a sleeping server and verify its health",
      "options": [{"type": 3, "name": "session-id", "description": "Session identifier", "required": true}]
    },
    {
      "type": 1,
      "name": "archive",
      "description": "Verify a portable backup, then remove EC2 and EBS",
      "options": [
        {"type": 3, "name": "session-id", "description": "Session identifier", "required": true},
        {"type": 5, "name": "confirm", "description": "Confirm verified backup followed by EC2 and EBS removal", "required": true}
      ]
    },
    {
      "type": 1,
      "name": "restore",
      "description": "Recreate infrastructure and restore a verified archive",
      "options": [
        {"type": 3, "name": "session-id", "description": "Archived session identifier", "required": true}
      ]
    },
    {
      "type": 1,
      "name": "terminate",
      "description": "Permanently delete a session and all associated resources",
      "options": [
        {"type": 3, "name": "session-id", "description": "Session identifier", "required": true},
        {"type": 5, "name": "confirm", "description": "Confirm irreversible deletion without creating a backup", "required": true}
      ]
    }
  ]
}
