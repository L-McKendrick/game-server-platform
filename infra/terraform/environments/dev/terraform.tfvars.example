discord_public_key               = "REPLACE_WITH_64_CHARACTER_HEX_PUBLIC_KEY"
discord_application_id           = "REPLACE_WITH_DISCORD_APPLICATION_ID"
discord_allowed_guild_ids        = ["REPLACE_WITH_DEVELOPMENT_GUILD_ID"]

# Keep disabled until the Phase 5 plan is reviewed and the budget email is set.
provisioning_enabled    = false
monthly_budget_limit_usd = 75
# budget_alert_email    = "REPLACE_WITH_ALERT_EMAIL"

provisioning_instance_type   = "c7i-flex.large"
provisioning_root_volume_gib = 30
provisioning_data_volume_gib = 100
max_provisioned_sessions     = 1
